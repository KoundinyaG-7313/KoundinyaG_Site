---
import '../styles/global.css';
import { Navbar } from '../components/Navbar';
import { SearchModal } from '../components/SearchModal';
import { profile } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Koundinya Gajulapalli (Max) — Theoretical Physics & Systems",
  description = "Personal website of Koundinya Gajulapalli (Max). Exploring theoretical physics, relational cosmology in 5D bulks, Linux systems engineering, Sarod acoustics, and endurance cycling.",
  image = "/research/GalaxyCurve.png"
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Koundinya Gajulapalli (Max)" />
    <meta name="theme-color" content="#030508" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- KaTeX CSS for LaTeX math rendering -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" crossorigin="anonymous">
  </head>
  <body class="bg-void text-gray-200 min-h-screen flex flex-col font-sans selection:bg-emerald-500/30 selection:text-emerald-300">
    <!-- Persistent Navigation Bar -->
    <Navbar client:load currentPath={currentPath} />

    <!-- Global Search Modal (Ctrl+K) -->
    <SearchModal client:load />

    <!-- Main Content Area -->
    <main class="flex-grow pt-20 pb-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full">
      <slot />
    </main>

    <!-- Clean Global Footer -->
    <footer class="border-t border-[#141e2e] bg-[#020407] font-mono text-xs text-gray-500 py-10 px-4 sm:px-6 lg:px-8">
      <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-8">
        <!-- Col 1: Bio & Manifesto -->
        <div class="md:col-span-2 space-y-3">
          <div class="flex items-center space-x-2">
            <div class="w-2 h-2 rounded-full bg-emerald-400" />
            <span class="text-white font-bold text-sm tracking-wider">Koundinya Gajulapalli (Max)</span>
          </div>
          <p class="text-xs text-gray-400 leading-relaxed max-w-lg">
            Theoretical cosmology, relational quantum gravity, and low-level Linux systems programming.
          </p>
          <div class="pt-1 text-[11px] text-emerald-400/90 italic border-l-2 border-emerald-500/40 pl-3">
            "Governments seek control. Corporations seek influence. Trust neither blindly."
          </div>
        </div>

        <!-- Col 2: Navigation Links -->
        <div class="space-y-2">
          <span class="text-xs text-gray-300 font-bold uppercase tracking-wider block">SECTIONS</span>
          <ul class="space-y-1.5 text-xs text-gray-400">
            <li><a href="/research" class="hover:text-emerald-400 transition-colors">Theoretical Research</a></li>
            <li><a href="/projects" class="hover:text-emerald-400 transition-colors">Software & Projects</a></li>
            <li><a href="/about" class="hover:text-emerald-400 transition-colors">About Me</a></li>
            <li><a href="/blog" class="hover:text-emerald-400 transition-colors">Essays & Notes</a></li>
            <li><a href="/music" class="hover:text-emerald-400 transition-colors">Sarod & Piano</a></li>
          </ul>
        </div>

        <!-- Col 3: Channels & Registry -->
        <div class="space-y-2">
          <span class="text-xs text-gray-300 font-bold uppercase tracking-wider block">IDENTIFIERS & CONTACT</span>
          <ul class="space-y-1.5 text-xs text-gray-400">
            <li><a href={profile.contact.github} target="_blank" rel="noopener noreferrer" class="hover:text-emerald-400 transition-colors">GitHub: @{profile.contact.githubUser}</a></li>
            <li><a href={`https://orcid.org/${profile.contact.orcidId}`} target="_blank" rel="noopener noreferrer" class="hover:text-emerald-400 transition-colors">ORCID: {profile.contact.orcidId}</a></li>
            <li><a href="/contact" class="hover:text-emerald-400 transition-colors">Email: {profile.contact.email}</a></li>
            <li><a href="/uses" class="hover:text-emerald-400 transition-colors">Uses // Arch Linux</a></li>
            <li><a href="/privacy" class="hover:text-emerald-400 transition-colors">Privacy: Zero Tracking</a></li>
          </ul>
        </div>
      </div>

      <div class="max-w-7xl mx-auto pt-8 mt-8 border-t border-[#0f1724] flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px]">
        <div>
          &copy; {new Date().getFullYear()} Koundinya Gajulapalli (Max).
        </div>
        <div class="flex items-center space-x-3 text-gray-400">
          <span>Astro 5 & KaTeX</span>
          <span>•</span>
          <span>Hosted on GitHub Pages</span>
        </div>
      </div>
    </footer>
  </body>
</html>
