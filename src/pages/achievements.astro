---
import Layout from '../layouts/Layout.astro';
import { achievements } from '../data/achievements';
---

<Layout title="Achievements & Authentic Milestones — Max">
  <div class="space-y-10 font-mono">
    <!-- Header -->
    <div class="border-b border-[#162334] pb-6 space-y-2">
      <div class="inline-flex items-center space-x-2 text-xs text-amber-400">
        <span class="w-2 h-2 rounded-full bg-amber-400"></span>
        <span>MILESTONES & OUTCOMES</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white">
        Authentic Milestones & Accomplishments
      </h1>
      <p class="text-sm text-gray-400 max-w-3xl leading-relaxed">
        Concrete outcomes earned through discipline, self-study, and building from scratch. No performative accolades, empty titles, or corporate buzzwords.
      </p>
    </div>

    <!-- Achievements Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {achievements.map((item) => (
        <div 
          key={item.title}
          class="p-6 rounded-lg bg-[#070c14] border border-[#162334] hover:border-amber-500/40 transition-all space-y-4 flex flex-col justify-between"
        >
          <div class="space-y-3">
            <div class="flex items-center justify-between text-xs border-b border-[#141e2e] pb-3">
              <span class="text-amber-400 font-bold uppercase tracking-wider">
                {item.category}
              </span>
              <span class="text-gray-500">{item.date}</span>
            </div>

            <h2 class="text-lg font-bold text-white">
              {item.title}
            </h2>

            <p class="text-xs text-cyan-400">
              {item.significance}
            </p>

            <p class="text-xs text-gray-300 leading-relaxed bg-[#03060a] p-3.5 rounded border border-[#141e2e]">
              {item.details}
            </p>
          </div>

          {item.metric && (
            <div class="pt-3 border-t border-[#141e2e] flex items-center justify-between text-xs">
              <span class="text-gray-500 uppercase text-[10px]">Verified Output:</span>
              <span class="text-emerald-400 font-bold px-2 py-0.5 rounded bg-[#0b121e] border border-emerald-900/50">
                {item.metric}
              </span>
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</Layout>
