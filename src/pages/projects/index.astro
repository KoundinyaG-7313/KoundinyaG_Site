---
import Layout from '../../layouts/Layout.astro';
import { projects } from '../../data/projects';
import { profile } from '../../data/profile';
---

<Layout title="Projects & GitHub Repositories — Max">
  <div class="space-y-10 font-mono">
    <!-- Header -->
    <div class="border-b border-[#162334] pb-6 space-y-3">
      <div class="flex items-center space-x-2 text-xs text-emerald-400">
        <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
        <span>GITHUB REPOSITORIES // KOUNDINYAG-7313</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white">
        Projects & Software
      </h1>
      <p class="text-sm text-gray-400 max-w-3xl leading-relaxed">
        Codebases maintained under <a href={profile.contact.github} target="_blank" rel="noopener noreferrer" class="text-emerald-400 hover:underline">@{profile.contact.githubUser}</a> on GitHub. Spanning low-level Linux systems in Rust and C++, microtonal audio engines, 3D physics experiments in Godot, and 3D printing CAD models.
      </p>

      <div class="pt-1">
        <a 
          href={profile.contact.github} 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center space-x-2 px-3 py-1.5 rounded bg-[#0d1624] border border-emerald-500/40 text-xs text-emerald-300 hover:bg-[#131f32] transition-colors"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
          </svg>
          <span>github.com/{profile.contact.githubUser}</span>
          <span>↗</span>
        </a>
      </div>
    </div>

    <!-- Projects List Directly Connected to GitHub -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {projects.map((proj) => (
        <article 
          key={proj.slug}
          class="p-6 rounded-lg bg-[#070c14] border border-[#162334] hover:border-emerald-500/50 transition-all flex flex-col justify-between space-y-5"
        >
          <div class="space-y-3">
            <div class="flex items-center justify-between text-xs border-b border-[#141e2e] pb-2.5">
              <span class="text-emerald-400 font-bold uppercase tracking-wider">
                {proj.category}
              </span>
              <div class="flex items-center space-x-2 text-gray-400 text-[11px]">
                <span class="px-2 py-0.5 rounded bg-[#0b121e] border border-[#162334] text-amber-400 font-bold">
                  {proj.commits} commits
                </span>
                <span>•</span>
                <span class="text-cyan-400">{proj.status}</span>
              </div>
            </div>

            <div>
              <h2 class="text-xl font-bold text-white hover:text-emerald-300">
                <a href={proj.githubUrl} target="_blank" rel="noopener noreferrer" class="flex items-center space-x-1.5">
                  <span>{proj.name}</span>
                  <span class="text-xs text-gray-500">↗</span>
                </a>
              </h2>
              <p class="text-xs text-gray-400 mt-1">
                {proj.tagline}
              </p>
            </div>

            <p class="text-xs text-gray-300 leading-relaxed bg-[#03060a] p-3 rounded border border-[#141e2e]">
              {proj.description}
            </p>

            <!-- Highlights -->
            <ul class="space-y-1 text-xs text-gray-400 pt-1">
              {proj.highlights.map((hl, i) => (
                <li key={i} class="flex items-start space-x-2">
                  <span class="text-emerald-400">▹</span>
                  <span class="text-gray-300">{hl}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="space-y-3 pt-3 border-t border-[#141e2e]">
            <div class="flex flex-wrap gap-1.5">
              {proj.techStack.map(t => (
                <span key={t} class="text-[10px] px-2 py-0.5 rounded bg-[#0b121e] text-gray-400 border border-[#1d2a3e]">
                  {t}
                </span>
              ))}
            </div>

            <div class="flex items-center justify-between text-xs pt-1">
              <a 
                href={proj.githubUrl} 
                target="_blank" 
                rel="noopener noreferrer"
                class="px-3.5 py-1.5 rounded bg-emerald-500 text-black font-bold hover:bg-emerald-400 transition-colors flex items-center space-x-1.5"
              >
                <span>Open on GitHub</span>
                <span>↗</span>
              </a>
              <a 
                href={`/projects/${proj.slug}`} 
                class="text-gray-400 hover:text-white transition-colors"
              >
                Notes &rarr;
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</Layout>
