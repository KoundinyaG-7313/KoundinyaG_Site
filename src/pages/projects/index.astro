---
import Layout from '../../layouts/Layout.astro';
import { projects } from '../../data/projects';
---

<Layout title="Systems & Software Projects — Max">
  <div class="space-y-10 font-mono">
    <!-- Header -->
    <div class="border-b border-[#162334] pb-6 space-y-2">
      <div class="inline-flex items-center space-x-2 text-xs text-arasaka-red">
        <span class="w-2 h-2 rounded-full bg-arasaka-red animate-pulse"></span>
        <span>ENGINEERING DECK // REPOSITORIES</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white">
        Systems, Software & Hardware Engineering
      </h1>
      <p class="text-sm text-gray-400 max-w-3xl leading-relaxed">
        Production code, low-level Linux kernel telemetry, microtonal music synthesis engines, 3D physics experiments, and parametric CAD designs. Built from scratch without bloated layers.
      </p>
    </div>

    <!-- Project Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {projects.map((proj) => (
        <article 
          key={proj.slug}
          class="p-6 rounded-lg bg-[#070c14] border border-[#162334] hover:border-emerald-500/50 transition-all flex flex-col justify-between space-y-6"
        >
          <div class="space-y-4">
            <div class="flex items-center justify-between text-xs border-b border-[#141e2e] pb-3">
              <span class="text-emerald-400 font-bold uppercase tracking-wider">
                {proj.category}
              </span>
              <div class="flex items-center space-x-2">
                <span class="text-[10px] text-gray-500 px-2 py-0.5 rounded bg-[#0b121e] border border-[#162334]">
                  STATUS: {proj.status}
                </span>
                <span class="text-[10px] text-amber-400/90 px-2 py-0.5 rounded bg-[#0b121e] border border-[#162334]">
                  {proj.commits} COMMITS
                </span>
              </div>
            </div>

            <div>
              <h2 class="text-xl font-bold text-white hover:text-emerald-300">
                <a href={`/projects/${proj.slug}`}>{proj.name}</a>
              </h2>
              <p class="text-xs text-gray-400 mt-1">
                {proj.tagline}
              </p>
            </div>

            <p class="text-xs text-gray-300 leading-relaxed bg-[#03060a] p-3.5 rounded border border-[#141e2e]">
              {proj.description}
            </p>

            <!-- Highlights -->
            <div class="space-y-1.5 pt-1">
              <span class="text-[10px] text-gray-500 uppercase tracking-wider font-bold">Key Architectural Features:</span>
              <ul class="space-y-1 text-xs text-gray-300">
                {proj.highlights.slice(0, 3).map((hl, i) => (
                  <li key={i} class="flex items-start space-x-2">
                    <span class="text-emerald-400">▹</span>
                    <span>{hl}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <div class="space-y-4 pt-4 border-t border-[#141e2e]">
            <!-- Technologies -->
            <div class="flex flex-wrap gap-1.5">
              {proj.techStack.map(t => (
                <span key={t} class="text-[10px] px-2 py-0.5 rounded bg-[#0b121e] text-gray-400 border border-[#1d2a3e]">
                  {t}
                </span>
              ))}
            </div>

            <div class="flex items-center justify-between text-xs pt-1">
              <a 
                href={proj.githubUrl} 
                target="_blank" 
                rel="noopener noreferrer"
                class="px-3 py-1.5 rounded bg-[#0d1624] text-gray-300 hover:text-white border border-[#1d2a3e] flex items-center space-x-1.5 transition-colors"
              >
                <span>View on GitHub</span>
                <span>↗</span>
              </a>
              <a 
                href={`/projects/${proj.slug}`} 
                class="px-4 py-1.5 rounded bg-emerald-500 text-black font-bold hover:bg-emerald-400 transition-colors"
              >
                Project Dossier &rarr;
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</Layout>
