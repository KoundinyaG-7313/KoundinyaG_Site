---
import Layout from '../../layouts/Layout.astro';
import { projects, type Project } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<Layout title={`${project.name} — Project Details`}>
  <div class="space-y-10 font-mono">
    <!-- Breadcrumbs -->
    <div class="flex items-center space-x-2 text-xs text-gray-500">
      <a href="/" class="hover:text-emerald-400">Home</a>
      <span>/</span>
      <a href="/projects" class="hover:text-emerald-400">Projects</a>
      <span>/</span>
      <span class="text-emerald-400">{project.slug}</span>
    </div>

    <!-- Header Box -->
    <div class="p-6 sm:p-8 rounded-lg bg-[#070c14] border border-[#162334] space-y-4">
      <div class="flex flex-wrap items-center justify-between gap-2 text-xs border-b border-[#141e2e] pb-3">
        <span class="text-emerald-400 font-bold uppercase tracking-wider">
          CATEGORY: {project.category}
        </span>
        <div class="flex items-center space-x-3 text-gray-400">
          <span>STATUS: <strong class="text-white">{project.status}</strong></span>
          <span>•</span>
          <span class="text-amber-400 font-bold">{project.commits} VERIFIED COMMITS</span>
        </div>
      </div>

      <h1 class="text-2xl sm:text-4xl font-extrabold text-white">
        {project.name}
      </h1>
      <p class="text-sm text-cyan-400/90 leading-relaxed">
        {project.tagline}
      </p>

      <!-- GitHub Link & Meta Buttons -->
      <div class="pt-2 flex flex-wrap gap-3 text-xs">
        <a
          href={project.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="px-5 py-2.5 rounded bg-emerald-500 text-black font-bold hover:bg-emerald-400 transition-all shadow-cyber-sm flex items-center space-x-2"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
          </svg>
          <span>VIEW REPOSITORY ON GITHUB</span>
        </a>
      </div>
    </div>

    <!-- Description & Overview -->
    <div class="p-6 rounded-lg bg-[#070c14] border border-[#162334] space-y-3">
      <h2 class="text-xs font-bold text-emerald-400 uppercase tracking-wider">
        SYSTEM OVERVIEW & PURPOSE
      </h2>
      <p class="text-xs sm:text-sm text-gray-300 leading-relaxed bg-[#03060a] p-4 rounded border border-[#141e2e]">
        {project.description}
      </p>
    </div>

    <!-- Key Highlights -->
    <div class="p-6 sm:p-8 rounded-lg bg-[#070c14] border border-[#162334] space-y-4">
      <h2 class="text-base font-bold text-white uppercase tracking-wider flex items-center space-x-2">
        <span class="text-emerald-400">FEATURES //</span>
        <span>KEY ARCHITECTURAL HIGHLIGHTS</span>
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {project.highlights.map((hl, idx) => (
          <div key={idx} class="p-4 rounded bg-[#03060a] border border-[#141e2e] space-y-1">
            <span class="text-xs font-bold text-white flex items-center space-x-2">
              <span class="text-emerald-400 font-mono">[{idx + 1}]</span>
              <span>Module Highlight</span>
            </span>
            <p class="text-xs text-gray-400 leading-relaxed pt-1">
              {hl}
            </p>
          </div>
        ))}
      </div>
    </div>

    <!-- Architecture & Systems Notes -->
    {project.architectureNotes && project.architectureNotes.length > 0 && (
      <div class="p-6 sm:p-8 rounded-lg bg-[#070c14] border border-[#162334] space-y-4">
        <h2 class="text-base font-bold text-white uppercase tracking-wider flex items-center space-x-2">
          <span class="text-cyan-400">DESIGN //</span>
          <span>LOW-LEVEL IMPLEMENTATION NOTES</span>
        </h2>
        <div class="space-y-3 text-xs sm:text-sm text-gray-300">
          {project.architectureNotes.map((note, i) => (
            <div key={i} class="p-3.5 rounded bg-[#03060a] border border-[#121c2c] flex items-start space-x-2">
              <span class="text-cyan-400 font-bold">▹</span>
              <span class="leading-relaxed">{note}</span>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Tech Stack Matrix -->
    <div class="p-6 rounded-lg bg-[#070c14] border border-[#162334] space-y-3">
      <h2 class="text-xs font-bold text-white uppercase tracking-wider">
        TECHNOLOGY STACK
      </h2>
      <div class="flex flex-wrap gap-2">
        {project.techStack.map(t => (
          <span key={t} class="px-3 py-1.5 rounded bg-[#0b121e] border border-[#1d2a3e] text-xs text-emerald-300">
            {t}
          </span>
        ))}
      </div>
    </div>
  </div>
</Layout>
