---
import Layout from '../layouts/Layout.astro';
import { TerminalManifesto } from '../components/TerminalManifesto';
import { WorldCanvas } from '../components/WorldCanvas';
import { profile } from '../data/profile';
import { researchProjects } from '../data/research';
import { projects } from '../data/projects';
import { staticGitHubData } from '../data/githubData';
import { observationLogs } from '../data/astronomy';
import { achievements } from '../data/achievements';
import { getCollection } from 'astro:content';

const blogPosts = await getCollection('blog');
const sortedPosts = blogPosts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()).slice(0, 3);
const featuredResearch = researchProjects[0];
const featuredProjects = projects.filter(p => p.featured).slice(0, 3);
---

<Layout title="Koundinya Gajulapalli (Max) — Theoretical Physics & Digital World">
  <!-- Hero Section with Terminal Manifesto -->
  <section class="py-6 sm:py-10 space-y-8">
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-emerald-950/40 border border-emerald-500/30 text-emerald-300 text-xs font-mono">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>NODE ID: KOUNDINYA_GAJULAPALLI // MAX</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white font-mono">
        Koundinya Gajulapalli <span class="text-emerald-400">— Max</span>
      </h1>
      <p class="text-sm sm:text-base text-gray-400 font-mono max-w-2xl mx-auto leading-relaxed">
        {profile.tagline}. Investigating higher-dimensional cosmology, low-level Linux systems, classical acoustics, and building systems from first principles.
      </p>

      <!-- Quick Action Buttons -->
      <div class="flex flex-wrap items-center justify-center gap-3 pt-2 font-mono text-xs">
        <a href="/research" class="px-5 py-2.5 rounded bg-emerald-500 text-black font-bold hover:bg-emerald-400 transition-all shadow-cyber-sm">
          EXPLORE RESEARCH &rarr;
        </a>
        <a href="/projects" class="px-5 py-2.5 rounded bg-[#0d1522] border border-[#1d2a3e] text-white hover:border-emerald-500/50 hover:bg-[#131f32] transition-all">
          SYSTEMS PROJECTS
        </a>
        <a href="/world" class="px-5 py-2.5 rounded bg-[#0d1522] border border-cyan-500/30 text-cyan-300 hover:border-cyan-400 hover:bg-[#131f32] transition-all">
          WORLD BIOME RADAR
        </a>
      </div>
    </div>

    <!-- The Animated Terminal Manifesto -->
    <div class="pt-2">
      <TerminalManifesto client:load />
    </div>
  </section>

  <!-- Interactive World Map Preview -->
  <section class="py-10 space-y-4">
    <div class="flex items-center justify-between border-b border-[#141e2e] pb-3">
      <div>
        <h2 class="text-lg font-bold text-white font-mono tracking-wide flex items-center space-x-2">
          <span class="text-cyan-400">01 //</span>
          <span>THE DIGITAL WORLD & BIOMES</span>
        </h2>
        <p class="text-xs text-gray-500 font-mono mt-0.5">
          Topological exploration across research, systems engineering, observatory, and abyss sectors.
        </p>
      </div>
      <a href="/world" class="text-xs text-emerald-400 hover:underline font-mono hidden sm:block">
        Full Screen Radar &rarr;
      </a>
    </div>

    <WorldCanvas client:visible />
  </section>

  <!-- About Snapshot & Currently Working On -->
  <section class="py-10 grid grid-cols-1 md:grid-cols-3 gap-6 font-mono">
    <!-- About Snapshot -->
    <div class="md:col-span-2 p-6 rounded-lg bg-[#070c14] border border-[#162334] space-y-4">
      <div class="flex items-center space-x-2 text-xs text-emerald-400">
        <span class="w-2 h-2 rounded-sm bg-emerald-400"></span>
        <span class="uppercase tracking-wider font-bold">ABOUT MAX // SYSTEM TELEMETRY</span>
      </div>
      <h3 class="text-xl font-bold text-white">
        "Building from the ground up to understand how reality actually works."
      </h3>
      <p class="text-xs text-gray-300 leading-relaxed">
        {profile.bio}
      </p>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2 text-xs">
        <div class="p-2.5 rounded bg-[#0b121e] border border-[#162334]">
          <span class="text-[10px] text-gray-500 block">PRIMARY FIELD</span>
          <span class="text-white font-bold">Theoretical Physics</span>
        </div>
        <div class="p-2.5 rounded bg-[#0b121e] border border-[#162334]">
          <span class="text-[10px] text-gray-500 block">SYSTEM OF CHOICE</span>
          <span class="text-emerald-400 font-bold">Arch Linux (btw)</span>
        </div>
        <div class="p-2.5 rounded bg-[#0b121e] border border-[#162334]">
          <span class="text-[10px] text-gray-500 block">INSTRUMENTS</span>
          <span class="text-cyan-400 font-bold">Sarod & Piano</span>
        </div>
        <div class="p-2.5 rounded bg-[#0b121e] border border-[#162334]">
          <span class="text-[10px] text-gray-500 block">ATHLETICS</span>
          <span class="text-amber-400 font-bold">Endurance Cycling</span>
        </div>
      </div>
      <div class="pt-2">
        <a href="/about" class="text-xs text-emerald-400 hover:text-emerald-300 flex items-center space-x-1">
          <span>Read Full Player Profile & Intellectual Dossier</span>
          <span>&rarr;</span>
        </a>
      </div>
    </div>

    <!-- Currently Working On -->
    <div class="p-6 rounded-lg bg-[#070c14] border border-[#162334] flex flex-col justify-between space-y-4">
      <div>
        <div class="flex items-center space-x-2 text-xs text-amber-400 mb-3">
          <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
          <span class="uppercase tracking-wider font-bold">CURRENT FOCUS // ACTIVE NODES</span>
        </div>
        <ul class="space-y-3 text-xs text-gray-300">
          {profile.currentFocus.map((focus, idx) => (
            <li key={idx} class="flex items-start space-x-2">
              <span class="text-emerald-400 mt-0.5">▹</span>
              <span class="leading-relaxed">{focus}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="pt-4 border-t border-[#141e2e]">
        <a href="/now" class="text-xs text-gray-400 hover:text-white flex items-center justify-between">
          <span>Inspect /now log</span>
          <span>&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Featured Research Spotlight -->
  <section class="py-10 space-y-4 font-mono">
    <div class="flex items-center justify-between border-b border-[#141e2e] pb-3">
      <div>
        <h2 class="text-lg font-bold text-white tracking-wide flex items-center space-x-2">
          <span class="text-emerald-400">02 //</span>
          <span>THEORETICAL COSMOLOGY RESEARCH</span>
        </h2>
        <p class="text-xs text-gray-500 mt-0.5">
          Relational dynamics and non-singular cyclic cosmology in ultrahyperbolic spacetimes.
        </p>
      </div>
      <a href="/research" class="text-xs text-emerald-400 hover:underline">
        All Research Papers &rarr;
      </a>
    </div>

    <div class="p-6 rounded-lg bg-[#070c14] border border-emerald-900/40 space-y-5">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-[#141e2e] pb-3">
        <span class="text-xs text-emerald-400 font-bold tracking-wider">
          FEATURED PREPRINT MONOGRAPH
        </span>
        <span class="text-xs text-gray-400">
          Date: {featuredResearch.date} // Status: {featuredResearch.status}
        </span>
      </div>

      <div>
        <h3 class="text-lg sm:text-xl font-bold text-white hover:text-emerald-300 transition-colors">
          <a href={`/research/${featuredResearch.slug}`}>
            {featuredResearch.title}
          </a>
        </h3>
        <p class="text-xs text-gray-500 mt-1">
          Authors: {featuredResearch.authors.join(', ')}
        </p>
      </div>

      <p class="text-xs text-gray-300 leading-relaxed">
        {featuredResearch.abstract}
      </p>

      <!-- Real Diagrams Preview Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2">
        {featuredResearch.figures.map((fig, idx) => (
          <a 
            key={idx} 
            href={`/research/${featuredResearch.slug}`}
            class="group block rounded border border-[#162334] overflow-hidden bg-[#020407] hover:border-emerald-500/50 transition-all"
          >
            <div class="aspect-[4/3] overflow-hidden relative">
              <img src={fig.path} alt={fig.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform" />
            </div>
            <div class="p-2 text-[10px] text-gray-400 group-hover:text-emerald-300 truncate">
              {fig.title}
            </div>
          </a>
        ))}
      </div>

      <div class="flex flex-wrap items-center justify-between gap-3 pt-3 border-t border-[#141e2e]">
        <div class="flex flex-wrap gap-1.5">
          {featuredResearch.topics.slice(0, 4).map(topic => (
            <span key={topic} class="text-[10px] px-2 py-0.5 rounded bg-[#0d1624] text-gray-300 border border-[#162334]">
              {topic}
            </span>
          ))}
        </div>
        <div class="flex items-center space-x-3 text-xs">
          {featuredResearch.pdfPath && (
            <a 
              href={featuredResearch.pdfPath} 
              target="_blank"
              class="px-3 py-1.5 rounded bg-emerald-500/10 border border-emerald-500/40 text-emerald-300 hover:bg-emerald-500/20 transition-all"
            >
              Download PDF (615 KB)
            </a>
          )}
          <a href={`/research/${featuredResearch.slug}`} class="text-emerald-400 hover:underline">
            Read Analytical Derivations &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Projects & GitHub Activity Grid -->
  <section class="py-10 space-y-4 font-mono">
    <div class="flex items-center justify-between border-b border-[#141e2e] pb-3">
      <div>
        <h2 class="text-lg font-bold text-white tracking-wide flex items-center space-x-2">
          <span class="text-arasaka-red">03 //</span>
          <span>SYSTEMS & SOFTWARE PROJECTS</span>
        </h2>
        <p class="text-xs text-gray-500 mt-0.5">
          Authentic production repositories with 93+ verified git commits.
        </p>
      </div>
      <a href="/projects" class="text-xs text-emerald-400 hover:underline">
        View Project Catalog &rarr;
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {featuredProjects.map(proj => (
        <div key={proj.slug} class="p-5 rounded-lg bg-[#070c14] border border-[#162334] flex flex-col justify-between hover:border-emerald-500/40 transition-all space-y-4">
          <div class="space-y-3">
            <div class="flex items-center justify-between text-xs">
              <span class="text-emerald-400 font-bold">{proj.category}</span>
              <span class="text-[10px] text-gray-500 px-1.5 py-0.5 rounded bg-[#0b121e] border border-[#162334]">
                {proj.commits} COMMITS
              </span>
            </div>
            <h3 class="text-base font-bold text-white hover:text-emerald-300">
              <a href={`/projects/${proj.slug}`}>{proj.name}</a>
            </h3>
            <p class="text-xs text-gray-400 leading-relaxed line-clamp-3">
              {proj.description}
            </p>
          </div>

          <div class="space-y-3 pt-3 border-t border-[#141e2e]">
            <div class="flex flex-wrap gap-1">
              {proj.techStack.slice(0, 3).map(t => (
                <span key={t} class="text-[10px] px-1.5 py-0.5 rounded bg-[#0b121e] text-gray-400">
                  {t}
                </span>
              ))}
            </div>
            <div class="flex items-center justify-between text-xs pt-1">
              <a href={proj.githubUrl} target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-white flex items-center space-x-1">
                <span>GitHub</span>
                <span>↗</span>
              </a>
              <a href={`/projects/${proj.slug}`} class="text-emerald-400 hover:underline">
                Details &rarr;
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Dual Module: Observatory & Acoustic Soundstage Previews -->
  <section class="py-10 grid grid-cols-1 md:grid-cols-2 gap-6 font-mono">
    <!-- Observatory Preview -->
    <div class="p-6 rounded-lg bg-[#070c14] border border-cyan-900/30 space-y-4">
      <div class="flex items-center justify-between">
        <span class="text-xs text-cyan-400 font-bold tracking-wider">04 // CELESTIAL OBSERVATORY</span>
        <span class="text-[10px] text-gray-500">M42 • M31 • SATURN</span>
      </div>
      <h3 class="text-base font-bold text-white">
        Astrophotography & High-Altitude Photon Collection
      </h3>
      <p class="text-xs text-gray-400 leading-relaxed">
        Deep-sky observation logs, equatorial tracking, and custom 3D-printed optical T-ring mounts capturing distant stellar nebulae.
      </p>
      <div class="p-3 rounded bg-[#03060a] border border-[#162334] text-xs space-y-1">
        <div class="flex justify-between text-gray-300">
          <span class="font-bold text-cyan-300">{observationLogs[0].target}</span>
          <span class="text-gray-500">{observationLogs[0].catalog}</span>
        </div>
        <p class="text-[11px] text-gray-400">
          {observationLogs[0].notes}
        </p>
      </div>
      <div class="pt-2">
        <a href="/astronomy" class="text-xs text-cyan-400 hover:underline">
          View Telescope Rig & Astrophotography Logs &rarr;
        </a>
      </div>
    </div>

    <!-- Acoustic Soundstage Preview -->
    <div class="p-6 rounded-lg bg-[#070c14] border border-amber-900/30 space-y-4">
      <div class="flex items-center justify-between">
        <span class="text-xs text-amber-400 font-bold tracking-wider">05 // ACOUSTICS & SAROD</span>
        <span class="text-[10px] text-gray-500">22 SHRUTIS • PIANO</span>
      </div>
      <h3 class="text-base font-bold text-white">
        The Geometry of Classical Strings & Algorithmic Audio
      </h3>
      <p class="text-xs text-gray-400 leading-relaxed">
        Exploring continuous microtonal meend on the handcrafted Indian classical Sarod, Western polyphonic piano, and browser oscillators.
      </p>
      <div class="p-3 rounded bg-[#03060a] border border-[#162334] text-xs space-y-1">
        <div class="flex justify-between text-gray-300">
          <span class="font-bold text-amber-300">Syntonic Comma: 21.5 cents</span>
          <span class="text-gray-500">Ratio: 81/80</span>
        </div>
        <p class="text-[11px] text-gray-400">
          Pure harmonic intervals derived from cycles of fifths and thirds, synthesized in Web Audio.
        </p>
      </div>
      <div class="pt-2">
        <a href="/music" class="text-xs text-amber-400 hover:underline">
          Test the Interactive 22-Shruti Synthesizer &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- Latest Blog Posts -->
  <section class="py-10 space-y-4 font-mono">
    <div class="flex items-center justify-between border-b border-[#141e2e] pb-3">
      <div>
        <h2 class="text-lg font-bold text-white tracking-wide flex items-center space-x-2">
          <span class="text-purple-400">06 //</span>
          <span>TECHNICAL WRITING & ESSAYS</span>
        </h2>
        <p class="text-xs text-gray-500 mt-0.5">
          First-principles derivations, systems architecture, and mathematical investigations.
        </p>
      </div>
      <a href="/blog" class="text-xs text-emerald-400 hover:underline">
        All Articles &rarr;
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {sortedPosts.map(post => (
        <a 
          key={post.slug} 
          href={`/blog/${post.slug}`}
          class="p-5 rounded-lg bg-[#070c14] border border-[#162334] hover:border-purple-500/40 transition-all flex flex-col justify-between space-y-3 group"
        >
          <div class="space-y-2">
            <div class="flex items-center justify-between text-[11px]">
              <span class="text-purple-400 font-bold">{post.data.category}</span>
              <span class="text-gray-500">{post.data.date}</span>
            </div>
            <h3 class="text-sm font-bold text-white group-hover:text-purple-300 transition-colors">
              {post.data.title}
            </h3>
            <p class="text-xs text-gray-400 line-clamp-3">
              {post.data.description}
            </p>
          </div>
          <div class="text-xs text-purple-400 flex items-center space-x-1 pt-2">
            <span>Read Article</span>
            <span>&rarr;</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Final Contact Banner -->
  <section class="py-12 text-center font-mono space-y-4 border-t border-[#141e2e]">
    <h2 class="text-xl font-bold text-white">
      Connect to the Network
    </h2>
    <p class="text-xs text-gray-400 max-w-lg mx-auto">
      For physics collaboration, systems research discussions, or chess / classical music inquiries.
    </p>
    <div class="flex justify-center gap-4 text-xs pt-2">
      <a href="/contact" class="px-5 py-2 rounded bg-emerald-500 text-black font-bold hover:bg-emerald-400 transition-colors">
        TRANSMIT MESSAGE
      </a>
      <a href={profile.contact.github} target="_blank" rel="noopener noreferrer" class="px-5 py-2 rounded bg-[#0d1522] border border-[#1d2a3e] text-white hover:bg-[#131f32] transition-colors">
        GITHUB PROFILE
      </a>
    </div>
  </section>
</Layout>
