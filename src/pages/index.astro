---
import Layout from '../layouts/Layout.astro';
import { TerminalManifesto } from '../components/TerminalManifesto';
import { profile } from '../data/profile';
import { researchProjects } from '../data/research';
import { projects } from '../data/projects';
import { staticGitHubData } from '../data/githubData';
import { observationLogs } from '../data/astronomy';
import { getCollection } from 'astro:content';

const blogPosts = await getCollection('blog');
const sortedPosts = blogPosts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()).slice(0, 3);
const featuredResearch = researchProjects[0];
const featuredProjects = projects.slice(0, 4);
---

<Layout title="Koundinya Gajulapalli (Max) — Theoretical Physics & Systems">
  <!-- Hero Section with Terminal Manifesto -->
  <section class="py-6 sm:py-10 space-y-8">
    <div class="text-center max-w-3xl mx-auto space-y-3 font-mono">
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-emerald-950/40 border border-emerald-500/30 text-emerald-300 text-xs">
        <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
        <span>KOUNDINYA GAJULAPALLI // MAX</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white">
        Koundinya Gajulapalli <span class="text-emerald-400">— Max</span>
      </h1>
      <p class="text-sm sm:text-base text-gray-400 max-w-2xl mx-auto leading-relaxed">
        {profile.tagline}. Investigating higher-dimensional cosmology, relational quantum gravity, low-level Linux systems, classical Sarod acoustics, and building systems from first principles.
      </p>

      <!-- Quick Action Buttons -->
      <div class="flex flex-wrap items-center justify-center gap-3 pt-2 text-xs">
        <a href="/research" class="px-5 py-2.5 rounded bg-emerald-500 text-black font-bold hover:bg-emerald-400 transition-colors">
          Theoretical Research &rarr;
        </a>
        <a href="/projects" class="px-5 py-2.5 rounded bg-[#0d1522] border border-[#1d2a3e] text-white hover:border-emerald-500/50 hover:bg-[#131f32] transition-colors">
          Software & Projects
        </a>
        <a href={`https://orcid.org/${profile.contact.orcidId}`} target="_blank" rel="noopener noreferrer" class="px-5 py-2.5 rounded bg-[#0d1522] border border-cyan-500/30 text-cyan-300 hover:border-cyan-400 hover:bg-[#131f32] transition-colors flex items-center space-x-1.5">
          <span>ORCID Registry</span>
          <span class="text-xs">↗</span>
        </a>
      </div>
    </div>

    <!-- The Animated Terminal Manifesto -->
    <div class="pt-2">
      <TerminalManifesto client:load />
    </div>
  </section>

  <!-- About Snapshot & Current Work -->
  <section class="py-8 grid grid-cols-1 md:grid-cols-3 gap-6 font-mono">
    <!-- About Snapshot -->
    <div class="md:col-span-2 p-6 rounded-lg bg-[#070c14] border border-[#162334] space-y-4">
      <div class="flex items-center space-x-2 text-xs text-emerald-400 font-bold uppercase tracking-wider">
        <span class="w-2 h-2 rounded-sm bg-emerald-400"></span>
        <span>ABOUT MAX</span>
      </div>
      <h2 class="text-xl font-bold text-white">
        "Building from the ground up to understand how reality actually works."
      </h2>
      <p class="text-xs text-gray-300 leading-relaxed">
        {profile.bio}
      </p>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2 text-xs">
        <div class="p-2.5 rounded bg-[#0b121e] border border-[#162334]">
          <span class="text-[10px] text-gray-500 block">PRIMARY FIELD</span>
          <span class="text-white font-bold">Theoretical Physics</span>
        </div>
        <div class="p-2.5 rounded bg-[#0b121e] border border-[#162334]">
          <span class="text-[10px] text-gray-500 block">DAILY OS</span>
          <span class="text-emerald-400 font-bold">Arch Linux (btw)</span>
        </div>
        <div class="p-2.5 rounded bg-[#0b121e] border border-[#162334]">
          <span class="text-[10px] text-gray-500 block">INSTRUMENTS</span>
          <span class="text-cyan-400 font-bold">Sarod & Piano</span>
        </div>
        <div class="p-2.5 rounded bg-[#0b121e] border border-[#162334]">
          <span class="text-[10px] text-gray-500 block">ATHLETICS</span>
          <span class="text-amber-400 font-bold">Endurance Cycling</span>
        </div>
      </div>
      <div class="pt-2">
        <a href="/about" class="text-xs text-emerald-400 hover:underline flex items-center space-x-1">
          <span>Read Full Background & Intellectual Interests</span>
          <span>&rarr;</span>
        </a>
      </div>
    </div>

    <!-- Currently Working On -->
    <div class="p-6 rounded-lg bg-[#070c14] border border-[#162334] flex flex-col justify-between space-y-4">
      <div>
        <div class="flex items-center space-x-2 text-xs text-amber-400 font-bold uppercase tracking-wider mb-3">
          <span class="w-2 h-2 rounded-full bg-amber-400"></span>
          <span>CURRENT FOCUS</span>
        </div>
        <ul class="space-y-3 text-xs text-gray-300">
          {profile.currentFocus.map((focus, idx) => (
            <li key={idx} class="flex items-start space-x-2">
              <span class="text-emerald-400 mt-0.5">▹</span>
              <span class="leading-relaxed">{focus}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="pt-4 border-t border-[#141e2e]">
        <a href="/now" class="text-xs text-gray-400 hover:text-white flex items-center justify-between">
          <span>Inspect /now log</span>
          <span>&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Theoretical Research Spotlight -->
  <section class="py-8 space-y-4 font-mono">
    <div class="flex items-center justify-between border-b border-[#162334] pb-3">
      <div>
        <h2 class="text-lg font-bold text-white tracking-wide">
          Theoretical Cosmology & Relational Time
        </h2>
        <p class="text-xs text-gray-400 mt-0.5">
          Research exploring higher-dimensional ultrahyperbolic bulk geometry and Machian time.
        </p>
      </div>
      <div class="flex items-center space-x-3 text-xs">
        <a href={`https://orcid.org/${profile.contact.orcidId}`} target="_blank" rel="noopener noreferrer" class="text-cyan-400 hover:underline">
          ORCID ↗
        </a>
        <span class="text-gray-600">|</span>
        <a href="/research" class="text-emerald-400 hover:underline">
          Research Page &rarr;
        </a>
      </div>
    </div>

    <div class="p-6 rounded-lg bg-[#070c14] border border-[#162334] space-y-5">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-[#141e2e] pb-3">
        <span class="text-xs text-emerald-400 font-bold tracking-wider">
          {featuredResearch.status}
        </span>
        <span class="text-xs text-gray-400">
          Date: {featuredResearch.date}
        </span>
      </div>

      <div>
        <h3 class="text-lg sm:text-xl font-bold text-white hover:text-emerald-300 transition-colors">
          <a href={`/research/${featuredResearch.slug}`}>
            {featuredResearch.title}
          </a>
        </h3>
        <p class="text-xs text-gray-400 mt-1">
          By {featuredResearch.authors.join(', ')}
        </p>
      </div>

      <p class="text-xs text-gray-300 leading-relaxed bg-[#03060a] p-4 rounded border border-[#141e2e]">
        {featuredResearch.abstract}
      </p>

      <!-- Real Diagrams Preview Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-1">
        {featuredResearch.figures.map((fig, idx) => (
          <a 
            key={idx} 
            href={`/research/${featuredResearch.slug}`}
            class="group block rounded border border-[#162334] overflow-hidden bg-[#020407] hover:border-emerald-500/50 transition-all"
          >
            <div class="aspect-[4/3] overflow-hidden">
              <img src={fig.path} alt={fig.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform" />
            </div>
            <div class="p-2 text-[10px] text-gray-400 group-hover:text-emerald-300 truncate">
              {fig.title}
            </div>
          </a>
        ))}
      </div>

      <div class="flex flex-wrap items-center justify-between gap-3 pt-3 border-t border-[#141e2e]">
        <div class="flex flex-wrap gap-1.5">
          {featuredResearch.topics.slice(0, 4).map(topic => (
            <span key={topic} class="text-[10px] px-2 py-0.5 rounded bg-[#0d1624] text-gray-300 border border-[#162334]">
              {topic}
            </span>
          ))}
        </div>
        <div class="flex items-center space-x-3 text-xs">
          {featuredResearch.pdfPath && (
            <a 
              href={featuredResearch.pdfPath} 
              target="_blank"
              class="px-3.5 py-1.5 rounded bg-[#0d1624] border border-emerald-500/40 text-emerald-300 hover:bg-[#131f32] transition-colors font-bold"
            >
              Download PDF (615 KB)
            </a>
          )}
          <a href={`/research/${featuredResearch.slug}`} class="px-4 py-1.5 rounded bg-emerald-500 text-black font-bold hover:bg-emerald-400 transition-colors">
            Read Analytical Formulations &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Software Projects Directly Linked to GitHub -->
  <section class="py-8 space-y-4 font-mono">
    <div class="flex items-center justify-between border-b border-[#162334] pb-3">
      <div>
        <h2 class="text-lg font-bold text-white tracking-wide">
          Software & Systems Projects
        </h2>
        <p class="text-xs text-gray-400 mt-0.5">
          Codebases hosted under @{profile.contact.githubUser} on GitHub.
        </p>
      </div>
      <a href="/projects" class="text-xs text-emerald-400 hover:underline">
        All Projects ({projects.length}) &rarr;
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {featuredProjects.map(proj => (
        <div key={proj.slug} class="p-5 rounded-lg bg-[#070c14] border border-[#162334] flex flex-col justify-between hover:border-emerald-500/40 transition-all space-y-4">
          <div class="space-y-3">
            <div class="flex items-center justify-between text-xs border-b border-[#141e2e] pb-2">
              <span class="text-emerald-400 font-bold uppercase tracking-wider">{proj.category}</span>
              <span class="text-[10px] text-amber-400 px-2 py-0.5 rounded bg-[#0b121e] border border-[#162334]">
                {proj.commits} commits
              </span>
            </div>
            <h3 class="text-base font-bold text-white hover:text-emerald-300">
              <a href={proj.githubUrl} target="_blank" rel="noopener noreferrer" class="flex items-center space-x-1.5">
                <span>{proj.name}</span>
                <span class="text-xs text-gray-500">↗</span>
              </a>
            </h3>
            <p class="text-xs text-gray-400 leading-relaxed">
              {proj.description}
            </p>
          </div>

          <div class="space-y-3 pt-3 border-t border-[#141e2e]">
            <div class="flex flex-wrap gap-1">
              {proj.techStack.map(t => (
                <span key={t} class="text-[10px] px-1.5 py-0.5 rounded bg-[#0b121e] text-gray-400">
                  {t}
                </span>
              ))}
            </div>
            <div class="flex items-center justify-between text-xs pt-1">
              <a href={proj.githubUrl} target="_blank" rel="noopener noreferrer" class="text-emerald-400 hover:underline flex items-center space-x-1">
                <span>GitHub Repository</span>
                <span>↗</span>
              </a>
              <a href={`/projects/${proj.slug}`} class="text-gray-400 hover:text-white transition-colors">
                Details &rarr;
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Classical Music & Observatory Previews -->
  <section class="py-8 grid grid-cols-1 md:grid-cols-2 gap-6 font-mono">
    <!-- Music Preview -->
    <div class="p-6 rounded-lg bg-[#070c14] border border-[#162334] space-y-4">
      <div class="flex items-center justify-between border-b border-[#141e2e] pb-2 text-xs">
        <span class="text-amber-400 font-bold uppercase tracking-wider">ACOUSTICS & SAROD</span>
        <span class="text-gray-500 text-[10px]">22 SHRUTIS • PIANO</span>
      </div>
      <h3 class="text-base font-bold text-white">
        Indian Classical Sarod & 22-Shruti Synthesizer
      </h3>
      <p class="text-xs text-gray-400 leading-relaxed">
        Practicing fretless steel microtonal meend on the handcrafted Sarod and classical piano counterpoint. An interactive browser synthesizer is available to hear the pure mathematical frequency ratios.
      </p>
      <div class="pt-2">
        <a href="/music" class="text-xs text-amber-400 hover:underline">
          Explore Music & 22-Shruti Synthesizer &rarr;
        </a>
      </div>
    </div>

    <!-- Observatory Preview -->
    <div class="p-6 rounded-lg bg-[#070c14] border border-[#162334] space-y-4">
      <div class="flex items-center justify-between border-b border-[#141e2e] pb-2 text-xs">
        <span class="text-cyan-400 font-bold uppercase tracking-wider">OBSERVATORY</span>
        <span class="text-gray-500 text-[10px]">M42 • M31 • SATURN</span>
      </div>
      <h3 class="text-base font-bold text-white">
        Astrophotography & Telescopes
      </h3>
      <p class="text-xs text-gray-400 leading-relaxed">
        Observational logs, deep-sky photon accumulation, and custom 3D-printed parametric optical adapters for telescope astrophotography.
      </p>
      <div class="pt-2">
        <a href="/astronomy" class="text-xs text-cyan-400 hover:underline">
          View Observation Logs & Rig &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- Recent Technical Essays -->
  <section class="py-8 space-y-4 font-mono">
    <div class="flex items-center justify-between border-b border-[#162334] pb-3">
      <div>
        <h2 class="text-lg font-bold text-white tracking-wide">
          Technical Essays & Notes
        </h2>
        <p class="text-xs text-gray-400 mt-0.5">
          First-principles derivations, software architecture, and mathematical inquiries.
        </p>
      </div>
      <a href="/blog" class="text-xs text-emerald-400 hover:underline">
        All Essays &rarr;
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {sortedPosts.map(post => (
        <a 
          key={post.slug} 
          href={`/blog/${post.slug}`}
          class="p-5 rounded-lg bg-[#070c14] border border-[#162334] hover:border-purple-500/40 transition-all flex flex-col justify-between space-y-3 group"
        >
          <div class="space-y-2">
            <div class="flex items-center justify-between text-[11px] border-b border-[#141e2e] pb-1.5">
              <span class="text-purple-400 font-bold">{post.data.category}</span>
              <span class="text-gray-500">{post.data.date}</span>
            </div>
            <h3 class="text-sm font-bold text-white group-hover:text-purple-300 transition-colors">
              {post.data.title}
            </h3>
            <p class="text-xs text-gray-400 line-clamp-3">
              {post.data.description}
            </p>
          </div>
          <div class="text-xs text-purple-400 flex items-center space-x-1 pt-2">
            <span>Read Essay</span>
            <span>&rarr;</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Direct Contact Footer Banner -->
  <section class="py-10 text-center font-mono space-y-3 border-t border-[#141e2e]">
    <h2 class="text-lg font-bold text-white">
      Get in Touch
    </h2>
    <p class="text-xs text-gray-400 max-w-lg mx-auto">
      For physics collaboration, systems programming discussions, or inquiries.
    </p>
    <div class="flex justify-center gap-4 text-xs pt-2">
      <a href={`mailto:${profile.contact.email}`} class="px-5 py-2 rounded bg-emerald-500 text-black font-bold hover:bg-emerald-400 transition-colors">
        {profile.contact.email}
      </a>
      <a href={profile.contact.github} target="_blank" rel="noopener noreferrer" class="px-5 py-2 rounded bg-[#0d1522] border border-[#1d2a3e] text-white hover:bg-[#131f32] transition-colors">
        GitHub Profile ↗
      </a>
    </div>
  </section>
</Layout>
