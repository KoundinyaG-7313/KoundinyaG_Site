---
import Layout from '../layouts/Layout.astro';
import { publications } from '../data/publications';
import { profile } from '../data/profile';
---

<Layout title="Publications & Manuscripts — Max">
  <div class="space-y-10 font-mono">
    <!-- Header -->
    <div class="border-b border-[#162334] pb-6 space-y-2">
      <div class="inline-flex items-center space-x-2 text-xs text-emerald-400">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>ACADEMIC REGISTRY // ORCID INTEGRATION</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white">
        Publications & Academic Manuscripts
      </h1>
      <p class="text-sm text-gray-400 max-w-3xl leading-relaxed">
        Research papers, preprints, and theoretical monographs. Synchronized with public ORCID registry data without external runtime dependencies.
      </p>

      <div class="flex items-center space-x-3 pt-2 text-xs">
        <span class="text-gray-500">ORCID ID:</span>
        <a 
          href={`https://orcid.org/${profile.contact.orcidId}`}
          target="_blank" 
          rel="noopener noreferrer"
          class="px-2.5 py-1 rounded bg-[#0b121e] border border-emerald-500/40 text-emerald-300 hover:bg-[#101b2e] flex items-center space-x-1.5"
        >
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          <span>{profile.contact.orcidId}</span>
          <span>↗</span>
        </a>
      </div>
    </div>

    <!-- Publications List -->
    <div class="space-y-6">
      {publications.map((pub) => (
        <article key={pub.id} class="p-6 rounded-lg bg-[#070c14] border border-[#162334] hover:border-emerald-500/40 transition-all space-y-4">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between text-xs border-b border-[#141e2e] pb-3 gap-2">
            <span class="text-emerald-400 font-bold uppercase tracking-wider">
              {pub.status}
            </span>
            <div class="flex items-center space-x-3 text-gray-400">
              <span>{pub.date}</span>
              <span>•</span>
              <span class="text-cyan-400">{pub.venue}</span>
            </div>
          </div>

          <div>
            <h2 class="text-lg sm:text-xl font-bold text-white hover:text-emerald-300">
              <a href={pub.externalUrl || '#'}>{pub.title}</a>
            </h2>
            <p class="text-xs text-gray-500 mt-1">
              Authors: {pub.authors.join(', ')}
            </p>
          </div>

          <p class="text-xs sm:text-sm text-gray-300 leading-relaxed bg-[#03060a] p-4 rounded border border-[#141e2e]">
            {pub.abstract}
          </p>

          <div class="flex flex-wrap items-center justify-between gap-4 pt-2 text-xs">
            <div class="flex flex-wrap gap-1.5">
              {pub.topics.map(t => (
                <span key={t} class="text-[10px] px-2 py-0.5 rounded bg-[#0b121e] text-gray-400 border border-[#1d2a3e]">
                  {t}
                </span>
              ))}
            </div>

            <div class="flex items-center space-x-3">
              {pub.pdfUrl && (
                <a 
                  href={pub.pdfUrl} 
                  target="_blank" 
                  class="px-3 py-1.5 rounded bg-emerald-500/10 border border-emerald-500/40 text-emerald-300 hover:bg-emerald-500/20 transition-all font-bold"
                >
                  Download PDF
                </a>
              )}
              {pub.externalUrl && (
                <a href={pub.externalUrl} class="text-emerald-400 hover:underline">
                  Full Details &rarr;
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</Layout>
