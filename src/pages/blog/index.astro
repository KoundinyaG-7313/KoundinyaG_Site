---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const featuredPost = sortedPosts.find(p => p.data.featured) || sortedPosts[0];
---

<Layout title="Blog & Technical Essays — Max">
  <div class="space-y-10 font-mono">
    <!-- Header -->
    <div class="border-b border-[#162334] pb-6 space-y-2">
      <div class="inline-flex items-center space-x-2 text-xs text-purple-400">
        <span class="w-2 h-2 rounded-full bg-purple-400 animate-pulse"></span>
        <span>WRITING ARCHIVE // FIRST-PRINCIPLES ESSAYS</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white">
        Essays, Physics Derivations & Architecture
      </h1>
      <p class="text-sm text-gray-400 max-w-3xl leading-relaxed">
        Deep dives into relational cosmology, canonical quantum gravity, bare-metal Linux systems programming, and microtonal acoustics.
      </p>
    </div>

    <!-- Featured Post Hero -->
    {featuredPost && (
      <article class="p-6 sm:p-8 rounded-lg bg-[#070c14] border border-purple-900/50 hover:border-purple-500/50 transition-all space-y-4">
        <div class="flex items-center justify-between text-xs border-b border-[#141e2e] pb-3">
          <span class="text-purple-400 font-bold uppercase tracking-wider">
            FEATURED ESSAY // {featuredPost.data.category}
          </span>
          <span class="text-gray-500">{featuredPost.data.date}</span>
        </div>

        <h2 class="text-xl sm:text-3xl font-extrabold text-white hover:text-purple-300 transition-colors">
          <a href={`/blog/${featuredPost.slug}`}>
            {featuredPost.data.title}
          </a>
        </h2>

        <p class="text-xs sm:text-sm text-gray-300 leading-relaxed bg-[#03060a] p-4 rounded border border-[#141e2e]">
          {featuredPost.data.description}
        </p>

        <div class="flex flex-wrap items-center justify-between gap-4 pt-2 text-xs">
          <div class="flex flex-wrap gap-1.5">
            {featuredPost.data.tags.map(t => (
              <span key={t} class="text-[10px] px-2 py-0.5 rounded bg-[#0b121e] text-gray-400 border border-[#1d2a3e]">
                #{t}
              </span>
            ))}
          </div>

          <a 
            href={`/blog/${featuredPost.slug}`}
            class="px-4 py-1.5 rounded bg-purple-600 text-white font-bold hover:bg-purple-500 transition-colors"
          >
            Read Complete Essay &rarr;
          </a>
        </div>
      </article>
    )}

    <!-- All Posts Directory -->
    <div class="space-y-4">
      <h2 class="text-base font-bold text-white uppercase tracking-wider flex items-center space-x-2">
        <span class="text-emerald-400">ARCHIVES //</span>
        <span>ALL ARTICLES & NOTES</span>
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {sortedPosts.map(post => (
          <article 
            key={post.slug}
            class="p-6 rounded-lg bg-[#070c14] border border-[#162334] hover:border-emerald-500/40 transition-all flex flex-col justify-between space-y-4"
          >
            <div class="space-y-3">
              <div class="flex items-center justify-between text-xs border-b border-[#141e2e] pb-2">
                <span class="text-emerald-400 font-bold">{post.data.category}</span>
                <span class="text-gray-500">{post.data.date}</span>
              </div>

              <h3 class="text-base font-bold text-white hover:text-emerald-300">
                <a href={`/blog/${post.slug}`}>{post.data.title}</a>
              </h3>

              <p class="text-xs text-gray-400 leading-relaxed line-clamp-3">
                {post.data.description}
              </p>
            </div>

            <div class="space-y-3 pt-3 border-t border-[#141e2e]">
              <div class="flex flex-wrap gap-1">
                {post.data.tags.map(t => (
                  <span key={t} class="text-[10px] px-1.5 py-0.5 rounded bg-[#0b121e] text-gray-400">
                    #{t}
                  </span>
                ))}
              </div>

              <div class="pt-1">
                <a href={`/blog/${post.slug}`} class="text-xs text-emerald-400 hover:underline flex items-center space-x-1">
                  <span>Read Article</span>
                  <span>&rarr;</span>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</Layout>
