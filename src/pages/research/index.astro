---
import Layout from '../../layouts/Layout.astro';
import { researchProjects } from '../../data/research';
import { MathBlock } from '../../components/MathBlock';
import { profile } from '../../data/profile';

const mainPaper = researchProjects[0];
---

<Layout title="Theoretical Physics & Cosmology Research — Max">
  <div class="space-y-10 font-mono">
    <!-- Header -->
    <div class="border-b border-[#162334] pb-6 space-y-3">
      <div class="flex items-center space-x-2 text-xs text-emerald-400">
        <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
        <span>THEORETICAL COSMOLOGY & RELATIONAL DYNAMICS</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white">
        Theoretical Physics Research
      </h1>
      <p class="text-sm text-gray-400 max-w-3xl leading-relaxed">
        My primary intellectual work centers on theoretical cosmology, relational dynamics, and quantum-gravity-related ideas. Formal academic identifiers and registered works are linked directly to my public ORCID registry profile.
      </p>

      <!-- Prominent ORCID Link -->
      <div class="pt-1 flex flex-wrap items-center gap-3">
        <a 
          href={`https://orcid.org/${profile.contact.orcidId}`}
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center space-x-2 px-3 py-1.5 rounded bg-[#0d1624] border border-emerald-500/40 text-xs text-emerald-300 hover:bg-[#131f32] transition-colors"
        >
          <svg class="w-4 h-4 text-[#a6ce39]" viewBox="0 0 256 256" fill="currentColor">
            <path d="M128 0C57.3 0 0 57.3 0 128s57.3 128 128 128 128-57.3 128-128S198.7 0 128 0zm-42.3 194.7H60.2V83.1h25.5v111.6zm-12.8-127c-8.2 0-14.8-6.6-14.8-14.8s6.6-14.8 14.8-14.8 14.8 6.6 14.8 14.8-6.6 14.8-14.8 14.8zm124.6 63.8c0 35.8-21.7 54.8-54.8 54.8h-41.5V83.1h44.3c31.5 0 52 20.3 52 51.4zm-26.6 0c0-21.7-12.8-33.8-30.8-33.8h-14.7v67.7h14.7c18 0 30.8-12.1 30.8-33.9z"/>
          </svg>
          <span>ORCID: {profile.contact.orcidId}</span>
          <span class="text-xs text-gray-500">↗</span>
        </a>
      </div>
    </div>

    <!-- Main Research Monograph -->
    <article class="p-6 sm:p-8 rounded-lg bg-[#070c14] border border-[#162334] space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-[#141e2e] pb-3 gap-2 text-xs">
        <span class="text-emerald-400 font-bold uppercase tracking-wider">
          {mainPaper.category}
        </span>
        <div class="flex items-center space-x-3 text-gray-400">
          <span>Date: {mainPaper.date}</span>
          <span>•</span>
          <span class="text-cyan-400">{mainPaper.status}</span>
        </div>
      </div>

      <div>
        <h2 class="text-2xl sm:text-3xl font-bold text-white hover:text-emerald-300 transition-colors">
          <a href={`/research/${mainPaper.slug}`}>{mainPaper.title}</a>
        </h2>
        <p class="text-xs text-gray-400 mt-1">
          By {mainPaper.authors.join(', ')}
        </p>
      </div>

      <!-- Abstract -->
      <div class="space-y-2">
        <span class="text-xs text-gray-400 uppercase tracking-wider block font-bold">Abstract</span>
        <p class="text-xs sm:text-sm text-gray-300 leading-relaxed bg-[#03060a] p-4 rounded border border-[#141e2e]">
          {mainPaper.abstract}
        </p>
      </div>

      <!-- Sample Key Equation -->
      <div class="p-4 bg-[#020407] rounded border border-[#141e2e] space-y-1.5">
        <span class="text-[11px] text-gray-400 uppercase block font-bold">{mainPaper.keyEquations[0].label}</span>
        <MathBlock client:visible latex={mainPaper.keyEquations[0].latex} />
        <p class="text-xs text-gray-500 text-center font-mono">
          {mainPaper.keyEquations[0].description}
        </p>
      </div>

      <!-- Figures Preview -->
      <div class="space-y-2 pt-2">
        <span class="text-xs text-gray-400 uppercase tracking-wider block font-bold">Numerical Simulation Figures</span>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          {mainPaper.figures.map((fig, idx) => (
            <a key={idx} href={`/research/${mainPaper.slug}`} class="block rounded border border-[#162334] overflow-hidden bg-[#03060a] hover:border-emerald-500/50 transition-all group">
              <div class="aspect-[4/3] overflow-hidden">
                <img src={fig.path} alt={fig.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform" />
              </div>
              <div class="p-2 text-[10px] text-gray-400 group-hover:text-emerald-300 truncate">
                {fig.title}
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center justify-between pt-4 border-t border-[#141e2e] gap-4">
        <div class="flex flex-wrap gap-1.5">
          {mainPaper.topics.map(t => (
            <span key={t} class="text-[10px] px-2 py-0.5 rounded bg-[#0b121e] text-gray-400 border border-[#1d2a3e]">
              {t}
            </span>
          ))}
        </div>

        <div class="flex items-center space-x-3 text-xs">
          {mainPaper.pdfPath && (
            <a 
              href={mainPaper.pdfPath} 
              target="_blank" 
              class="px-3.5 py-1.5 rounded bg-[#0d1624] border border-emerald-500/40 text-emerald-300 hover:bg-[#131f32] transition-colors font-bold"
            >
              Download PDF (615 KB)
            </a>
          )}
          <a 
            href={`/research/${mainPaper.slug}`} 
            class="px-4 py-1.5 rounded bg-emerald-500 text-black font-bold hover:bg-emerald-400 transition-colors"
          >
            Read Full Analysis &rarr;
          </a>
        </div>
      </div>
    </article>
  </div>
</Layout>
