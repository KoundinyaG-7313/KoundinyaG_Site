---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 — Page Not Found">
  <div class="py-20 text-center font-mono space-y-5 max-w-xl mx-auto">
    <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-[#162334] text-gray-300 text-xs">
      <span>HTTP 404</span>
    </div>

    <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight">
      Page Not Found
    </h1>

    <p class="text-xs sm:text-sm text-gray-400 leading-relaxed">
      The requested route does not exist or has been moved.
    </p>

    <!-- Quick Navigation Links -->
    <div class="pt-4 flex flex-wrap justify-center gap-3 text-xs">
      <a href="/" class="px-5 py-2.5 rounded bg-emerald-500 text-black font-bold hover:bg-emerald-400 transition-colors">
        Return Home &rarr;
      </a>
      <a href="/research" class="px-5 py-2.5 rounded bg-[#0d1522] border border-[#1d2a3e] text-white hover:bg-[#131f32] transition-colors">
        Research
      </a>
      <a href="/projects" class="px-5 py-2.5 rounded bg-[#0d1522] border border-[#1d2a3e] text-white hover:bg-[#131f32] transition-colors">
        Projects
      </a>
    </div>
  </div>
</Layout>
