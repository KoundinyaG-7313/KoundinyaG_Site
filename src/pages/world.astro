---
import Layout from '../layouts/Layout.astro';
import { WorldCanvas } from '../components/WorldCanvas';
import { worldBiomes } from '../data/worldBiomes';
---

<Layout title="The Digital World & Topological Biomes — Max">
  <div class="space-y-10 font-mono">
    <!-- Header -->
    <div class="border-b border-[#162334] pb-6 space-y-2">
      <div class="inline-flex items-center space-x-2 text-xs text-cyan-400">
        <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
        <span>CARTOGRAPHY // SECTOR TOPOLOGY</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white">
        The Digital World Biomes
      </h1>
      <p class="text-sm text-gray-400 max-w-3xl leading-relaxed">
        A spatial representation of intellectual domains: from the subterranean Relational Laboratory exploring 5D quantum cosmology to the high alpine Celestial Observatory and the Subnautic Abyss.
      </p>
    </div>

    <!-- Interactive Radar Map Viewport -->
    <WorldCanvas client:load />

    <!-- Biomes Dossier Grid -->
    <div class="space-y-6 pt-4">
      <h2 class="text-base font-bold text-white uppercase tracking-wider flex items-center space-x-2">
        <span class="text-emerald-400">SECTORS //</span>
        <span>ENVIRONMENTAL DOSSIERS</span>
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {worldBiomes.map((biome) => (
          <div 
            key={biome.id}
            class="p-6 rounded-lg bg-[#070c14] border border-[#162334] hover:border-emerald-500/40 transition-all space-y-4"
          >
            <div class="flex items-center justify-between border-b border-[#141e2e] pb-3 text-xs">
              <span class="font-bold tracking-wider" style={{ color: biome.accentHex }}>
                {biome.name}
              </span>
              <span class="text-gray-500">{biome.coordinates}</span>
            </div>

            <p class="text-xs text-gray-300 leading-relaxed bg-[#03060a] p-3.5 rounded border border-[#141e2e]">
              {biome.lore}
            </p>

            <div class="space-y-1.5 pt-1">
              <span class="text-[10px] text-gray-500 uppercase tracking-wider font-bold">Subsystems & Sensors:</span>
              <ul class="space-y-1 text-xs text-gray-300">
                {biome.features.map((feat, i) => (
                  <li key={i} class="flex items-center space-x-2">
                    <span style={{ color: biome.accentHex }}>▹</span>
                    <span>{feat}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="pt-3 border-t border-[#141e2e]">
              <a 
                href={biome.targetRoute}
                class="text-xs font-bold hover:underline flex items-center space-x-1"
                style={{ color: biome.accentHex }}
              >
                <span>Access Sector Node</span>
                <span>&rarr;</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</Layout>
