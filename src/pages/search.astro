---
import Layout from '../layouts/Layout.astro';
import { SearchModal } from '../components/SearchModal';
import { projects } from '../data/projects';
import { researchProjects } from '../data/research';
import { worldBiomes } from '../data/worldBiomes';
---

<Layout title="Search Directory — Max">
  <div class="space-y-10 font-mono">
    <!-- Header -->
    <div class="border-b border-[#162334] pb-6 space-y-2">
      <div class="inline-flex items-center space-x-2 text-xs text-emerald-400">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>INDEX SEARCH // GLOBAL DIRECTORY</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white">
        Search & Index Directory
      </h1>
      <p class="text-sm text-gray-400 max-w-3xl leading-relaxed">
        Quickly navigate all documents, research papers, projects, and world biomes across the digital world. Press <kbd class="px-1.5 py-0.5 rounded bg-[#162334] text-white">Ctrl+K</kbd> anywhere on the site for instant modal search.
      </p>

      <div class="pt-3">
        <button
          onclick="window.dispatchEvent(new CustomEvent('open-search'))"
          class="px-5 py-2.5 rounded bg-emerald-500 text-black font-bold hover:bg-emerald-400 transition-colors text-xs flex items-center space-x-2 cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" strokeWidth={2} d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <span>TRIGGER KEYBOARD SEARCH (CTRL+K)</span>
        </button>
      </div>
    </div>

    <!-- Complete Directory Listing -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- Theoretical Physics -->
      <div class="p-6 rounded-lg bg-[#070c14] border border-[#162334] space-y-3">
        <h2 class="text-xs font-bold text-emerald-400 uppercase tracking-wider border-b border-[#141e2e] pb-2">
          Theoretical Research
        </h2>
        <ul class="space-y-2 text-xs">
          {researchProjects.map(r => (
            <li key={r.slug}>
              <a href={`/research/${r.slug}`} class="text-gray-300 hover:text-emerald-300 block truncate">
                {r.title}
              </a>
            </li>
          ))}
          <li>
            <a href="/publications" class="text-cyan-400 hover:underline">
              View all publications &rarr;
            </a>
          </li>
        </ul>
      </div>

      <!-- Systems Projects -->
      <div class="p-6 rounded-lg bg-[#070c14] border border-[#162334] space-y-3">
        <h2 class="text-xs font-bold text-cyan-400 uppercase tracking-wider border-b border-[#141e2e] pb-2">
          Systems Projects
        </h2>
        <ul class="space-y-2 text-xs">
          {projects.map(p => (
            <li key={p.slug}>
              <a href={`/projects/${p.slug}`} class="text-gray-300 hover:text-cyan-300 block truncate">
                {p.name}
              </a>
            </li>
          ))}
          <li>
            <a href="/github" class="text-emerald-400 hover:underline">
              View GitHub dashboard &rarr;
            </a>
          </li>
        </ul>
      </div>

      <!-- World Biomes -->
      <div class="p-6 rounded-lg bg-[#070c14] border border-[#162334] space-y-3">
        <h2 class="text-xs font-bold text-amber-400 uppercase tracking-wider border-b border-[#141e2e] pb-2">
          Topological Biomes
        </h2>
        <ul class="space-y-2 text-xs">
          {worldBiomes.map(b => (
            <li key={b.id}>
              <a href={b.targetRoute} class="text-gray-300 hover:text-amber-300 block truncate">
                {b.name}
              </a>
            </li>
          ))}
          <li>
            <a href="/world" class="text-amber-400 hover:underline">
              Open interactive radar &rarr;
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</Layout>
