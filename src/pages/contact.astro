---
import Layout from '../layouts/Layout.astro';
import { profile } from '../data/profile';
---

<Layout title="Contact — Max">
  <div class="space-y-10 font-mono">
    <!-- Header -->
    <div class="border-b border-[#162334] pb-6 space-y-3">
      <div class="flex items-center space-x-2 text-xs text-emerald-400">
        <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
        <span>COMMUNICATION</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white">
        Contact & Channels
      </h1>
      <p class="text-sm text-gray-400 max-w-3xl leading-relaxed">
        For theoretical physics discussions, collaboration on open-source systems, or other inquiries.
      </p>
    </div>

    <!-- Contact Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Email Card -->
      <div class="p-6 rounded-lg bg-[#070c14] border border-[#162334] space-y-4">
        <div class="flex items-center justify-between text-xs border-b border-[#141e2e] pb-2.5">
          <span class="text-emerald-400 font-bold uppercase tracking-wider">EMAIL</span>
          <span class="text-gray-500">OUTLOOK</span>
        </div>
        <div>
          <h2 class="text-lg font-bold text-white select-all">
            {profile.contact.email}
          </h2>
          <p class="text-xs text-gray-400 mt-1 leading-relaxed">
            Reach out via email for research correspondence, discussions, or inquiries.
          </p>
        </div>
        <div class="pt-2">
          <a 
            href={`mailto:${profile.contact.email}`}
            class="px-4 py-2 rounded bg-emerald-500 text-black font-bold hover:bg-emerald-400 transition-colors inline-block text-xs"
          >
            Send Email &rarr;
          </a>
        </div>
      </div>

      <!-- GitHub Card -->
      <div class="p-6 rounded-lg bg-[#070c14] border border-[#162334] space-y-4">
        <div class="flex items-center justify-between text-xs border-b border-[#141e2e] pb-2.5">
          <span class="text-cyan-400 font-bold uppercase tracking-wider">GITHUB</span>
          <span class="text-gray-500">SOURCE CODE</span>
        </div>
        <div>
          <h2 class="text-lg font-bold text-white">
            @{profile.contact.githubUser}
          </h2>
          <p class="text-xs text-gray-400 mt-1 leading-relaxed">
            Explore public repositories, code commits, and project contributions.
          </p>
        </div>
        <div class="pt-2">
          <a 
            href={profile.contact.github}
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 py-2 rounded bg-[#0d1624] border border-[#1d2a3e] text-white hover:bg-[#131f32] transition-colors inline-block text-xs"
          >
            Open GitHub Profile &rarr;
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>
